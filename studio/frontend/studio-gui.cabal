cabal-version: 3.0
name: studio-gui
version: 0.4.0.0
synopsis: CatDB Studio Miso interface
license: MIT
build-type: Simple

executable studio-gui
  main-is: Main.hs
  hs-source-dirs: app, ../shared
  other-modules: Studio.Wire, Model, View, Browser, Course, Canvas, DiagramLayout
  build-depends: base >=4.18 && <5, miso ==1.12.0.0, containers, mtl, text
  default-language: GHC2021
  default-extensions: LambdaCase OverloadedStrings
  ghc-options: -Wall -O2
  if arch(wasm32)
    build-depends: ghc-experimental
    cpp-options: -DWASM
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
