!/examples/
!/examples/*.hs
!/examples/*.json
!/samples/
!/samples/*.csv
!/reference/
!/reference/src/
!/reference/src/**
!/reference/web/
!/reference/web/*.html
!/reference/web/*.css
!/reference/web/*.js
!/docs/
!/docs/*.md
!/test/
!/test/*.hs
!/test/*.ps1
!/test/*.py
!/site/
!/site/*.html
!/site/*.css
!/site/*.js
!/site/*.svg
!/site/.nojekyll
!/site/assets/
!/site/assets/*.jpg
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/ISSUE_TEMPLATE/
