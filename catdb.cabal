cabal-version: 3.0
name: catdb
version: 0.4.0.0
synopsis: A small persistent database of finite functors
build-type: Simple
license: MIT
license-file: LICENSE
author: M-simplifier and contributors
maintainer: https://github.com/M-simplifier/catdb/issues
homepage: https://m-simplifier.github.io/catdb/
bug-reports: https://github.com/M-simplifier/catdb/issues
category: Database
tested-with: GHC ==9.6.7
description: A proof of concept embedded database with exact finite categorical
  schemas, functorial data migration, native catalogs and file persistence.
  CatDB Studio is its local Miso/WASM interface. Relay Desk is an application example.
extra-source-files: README.md, CONTRIBUTING.md, STATUS.md, docs/*.md,
  reference/web/*.html, reference/web/*.css, reference/web/*.js,
  samples/*.csv, examples/*.json, test/*.py, test/*.ps1,
  build.ps1, site/*.html, site/*.css, site/*.js, site/*.svg, site/assets/*.jpg, site/assets/*.png, site/ja/*.html,
  build-frontend.ps1, package-studio.ps1, "Start CatDB Studio.cmd", "Start Relay Desk.cmd", THIRD_PARTY_NOTICES.md,
  "Start Field Service.cmd", "Start Completed Example.cmd",
  "Start Reading Notes.cmd", "Start Mapping Example.cmd",
  studio/frontend/*.cabal, studio/frontend/cabal.project, studio/frontend/flake.nix,
  studio/frontend/flake.lock, studio/frontend/build.sh, studio/frontend/app/*.hs,
  studio/frontend/static/*.html, studio/frontend/static/*.css, studio/frontend/static/*.js,
  studio/frontend/static/*.svg, studio/frontend/static/vendor/wasi/*.js,
  studio/frontend/static/licenses/browser-wasi-shim-LICENSE-APACHE,
  studio/frontend/static/licenses/browser-wasi-shim-LICENSE-MIT,
  studio/frontend/static/licenses/miso-LICENSE,
  studio/frontend/static/licenses/*.txt, studio/frontend/static/licenses/*.json,
  scripts/*.py

source-repository head
  type: git
  location: https://github.com/M-simplifier/catdb.git

common settings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns
  default-extensions: OverloadedStrings DeriveGeneric DerivingStrategies GeneralizedNewtypeDeriving
  build-depends: base >=4.16 && <5, containers, text, bytestring, binary, aeson >=2, mtl, deepseq

library
  import: settings
  hs-source-dirs: src
  exposed-modules: CatDB, CatDB.Schema, CatDB.Instance, CatDB.Migration, CatDB.Store, CatDB.Budget, CatDB.System, CatDB.Catalog
  other-modules: CatDB.Internal, CatDB.Catalog.Core, CatDB.Catalog.Native
  c-sources: cbits/file.c
  include-dirs: cbits

executable catdb
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: Demo
  build-depends: catdb, directory, filepath
  ghc-options: -threaded -rtsopts

executable relay-desk
  import: settings
  hs-source-dirs: reference/src
  main-is: Main.hs
  other-modules: Relay.Model
  -- 3.4.13's STM receive wait hangs on our GHC 9.6 Windows runtime.
  build-depends: catdb, directory, filepath, wai >=3.2 && <3.3, warp ==3.4.12, http-types >=0.12 && <0.13
  ghc-options: -threaded -rtsopts

executable embedded-example
  import: settings
  hs-source-dirs: examples
  main-is: Embedded.hs
  build-depends: catdb

executable studio-export-example
  import: settings
  hs-source-dirs: examples
  main-is: StudioExport.hs
  build-depends: catdb

executable catdb-studio
  import: settings
  hs-source-dirs: studio/server, studio/shared
  main-is: Main.hs
  other-modules: Studio.Core, Studio.Runtime, Studio.Server, Studio.Wire, Studio.FieldService
  build-depends: catdb, directory, filepath, async, process, network,
    servant ==0.20.3.0, servant-server ==0.20.3.0,
    wai >=3.2 && <3.3, warp ==3.4.12, http-types >=0.12 && <0.13
  c-sources: studio/cbits/random.c
  if os(windows)
    extra-libraries: bcrypt
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2

test-suite laws
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, app, reference/src, studio/frontend/app
  main-is: Main.hs
  other-modules: Demo, Relay.Model, NativeMemory, DiagramTests, DiagramLayout
  build-depends: catdb, directory, filepath, process, QuickCheck >=2.14
  ghc-options: -threaded -rtsopts
